<Window x:Class="HOK.FamilyMatrixGenerator2023.Forms.FamilyMatrixGenForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HOK.FamilyMatrixGenerator2023.Forms"
        mc:Ignorable="d"
        Title="FamilyMatrixGenForm" Height="430" Width="850" MinWidth="550" MinHeight="430">
    <Grid>
        <GroupBox Header="Revit Families in Current Document" Margin="10,66,282,60" FontFamily="HOK Sans">
            <Grid>
                <ListView x:Name="lstViewRevitFamilies" Margin="10,40,10,45" FontFamily="HOK Sans" SelectionMode="Extended" DisplayMemberPath="FamilyName" SelectionChanged="lstViewRevitFamilies_SelectionChanged"/>
                <Button x:Name="btnCheckAll" Content="Check All" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontFamily="HOK Sans" Height="25" Width="80" Click="btnCheckAll_Click"/>
                <Button x:Name="btnCheckNone" Content="Check None" HorizontalAlignment="Left" Margin="95,10,0,0" VerticalAlignment="Top" FontFamily="HOK Sans" Height="25" Width="80" Click="btnCheckNone_Click"/>
                <Label Content="Select Category:" Margin="0,9,174,0" VerticalAlignment="Top" FontFamily="HOK Sans" HorizontalAlignment="Right" Width="107"/>
                <ComboBox x:Name="cmbBxSelectionFilter" Margin="0,11,10,0" VerticalAlignment="Top" FontFamily="HOK Sans" HorizontalAlignment="Right" Width="159" SelectionChanged="cmbBxSelectionFilter_SelectionChanged"/>
                <Label x:Name="lblSelectedFamilies" Content="Number of Selected Families: " HorizontalAlignment="Left" Margin="10,0,0,10" FontFamily="HOK Sans" FontSize="10" Height="25" VerticalAlignment="Bottom" FontStyle="Italic"/>
            </Grid>
        </GroupBox>
        <Button x:Name="btnPlaceFamilySymbols" Content="Place Selected Families on Current View" FontFamily="HOK Sans" Margin="10,0,10,10" Height="45" VerticalAlignment="Bottom" Click="btnPlaceFamilySymbols_Click"/>
        <Label Content="Current View:" FontFamily="HOK Sans" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top"/>
        <Label x:Name="lblViewName" FontSize="15" FontFamily="HOK Sans" HorizontalAlignment="Left" Margin="10,37,0,0" VerticalAlignment="Top"/>
        <GroupBox Header="Settings" Margin="0,66,10,60" FontFamily="HOK Sans" HorizontalAlignment="Right" Width="267">
            <Grid>
                <Label Content="Origin (XYZ):" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontFamily="HOK Sans"/>
                <TextBox x:Name="txtBxOriginX" PreviewTextInput="NumberValidationTextBox" Margin="10,42,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" HorizontalAlignment="Left"  Width="75"/>
                <TextBox x:Name="txtBxOriginY" PreviewTextInput="NumberValidationTextBox" Margin="90,42,0,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="75"/>
                <TextBox x:Name="txtBxOriginZ" PreviewTextInput="NumberValidationTextBox"  Margin="0,42,10,0" TextWrapping="Wrap" Text="0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="75"/>
                <Label Content="Spacing (X):" HorizontalAlignment="Left" Margin="10,66,0,0" VerticalAlignment="Top" FontFamily="HOK Sans"/>
                <TextBox x:Name="txtBxSpacingX" PreviewTextInput="NumberValidationTextBox" Margin="18,98,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" HorizontalAlignment="Left"  Width="75"/>
                <Label Content="Spacing (Y):" HorizontalAlignment="Left" Margin="10,122,0,0" VerticalAlignment="Top" FontFamily="HOK Sans"/>
                <TextBox x:Name="txtBxSpacingY" PreviewTextInput="NumberValidationTextBox" Margin="18,154,0,0" TextWrapping="Wrap" Text="10" VerticalAlignment="Top" HorizontalAlignment="Left"  Width="75"/>
                <Label Content="Number of Columns:" HorizontalAlignment="Left" Margin="10,178,0,0" VerticalAlignment="Top" FontFamily="HOK Sans"/>
                <TextBox x:Name="txtBxNumColumns" PreviewTextInput="NumberValidationTextBox" Margin="18,210,0,0" TextWrapping="Wrap" Text="4" VerticalAlignment="Top" HorizontalAlignment="Left"  Width="75"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>